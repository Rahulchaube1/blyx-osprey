use osprey;

fn main() {
    let pred = [-2, 0, 2, 2];
    let truth = [0, 0, 4, 2];
    let width = 4.0;
    let height = 4.0;
    let threshold = 0.5;
    let result = osprey_compare(pred, truth, width, height, threshold);
    if len(result) == 0 { println!("invalid"); return; }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
